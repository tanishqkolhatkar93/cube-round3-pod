# Copy to .env and fill in. NEVER commit .env (it is git-ignored). Placeholders only in THIS file.
# A leaked key is revoked and may affect your submission. Remove debug credentials before you submit.

# --- Orchestration -----------------------------------------------------------
# ORCH_MODE=            # blank: use each agent.json "mode". Or force: inproc | http
# ORCH_FLOW=            # blank: use the flow named in pod.json
# OUT_DIR=out           # where workflow state and evidence are written (workflows/, evidence/)
LOG_LEVEL=INFO          # DEBUG | INFO | WARNING
LOG_FORMAT=json         # json | text

# --- Operations console access (server-side only) ---------------------------
# Set unique, high-entropy secrets for each tenant. Never put these in browser storage.
ORG_ALPHA_TOKEN=replace-with-a-long-random-secret
ORG_BRAVO_TOKEN=replace-with-a-long-random-secret

# --- Data --------------------------------------------------------------------
# DATA_DIR=data/sample  # where the organiser stub agents read the Round 2 sample CSVs
# INPUT_DIR=data/input  # per-stage captures: <INPUT_DIR>/<subject_id>/<stage>/<file>

# --- Agent services (only for agents running in http mode) -------------------
# RECEIVING_URL=http://localhost:8101
# PREP_URL=http://localhost:8102
# PACK_URL=http://localhost:8103
# RETURNS_URL=http://localhost:8104
# RECOVERY_URL=http://localhost:8105

# --- Model providers (use whichever your agents use; leave the rest out) -----
# ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here
# GEMINI_API_KEY=your-key-here
# Receiving/Returns: explicitly select ONE process credential (default primary).
# GEMINI_API_KEY_ENV=GEMINI_API_KEY
# Optional values: GEMINI_API_KEY_2 or GEMINI_API_KEY_3; supply keys securely
# through the service environment. No automatic rotation, retry or key failover.
# Prep/Pack/Recovery already select an environment name through api_key_env.
# MODEL_NAME=

# Receiving: explicit server-side configuration (no automatic .env loading).
# GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
# RECEIVING_CAPTURE_REGISTRY=agents/receiving/fixtures/captures.json
# RECEIVING_UNIT_REGISTRY=agents/receiving/fixtures/units.json
# RECEIVING_STATE_DIR=out/receiving
# RECEIVING_CACHE_DIR=out/receiving-cache
# RECEIVING_TIMEOUT_S=20

# Trusted manager registrations and writable durable state (absolute paths).
# Prepare registrations using each agents/<stage>/README.md. Keys alone are
# insufficient; the UI cannot register captures or authorize source ownership.
# PREP_CONFIG=
# PREP_STATE_DIR=
# PACK_CONFIG=
# PACK_STATE_DIR=
# RETURNS_CONFIG=
# RETURNS_STATE_DIR=
# RECOVERY_CONFIG=
# RECOVERY_STATE_DIR=

# Returns live inspection selects exactly one provider in RETURNS_CONFIG.
# Ollama: provider.settings.base_url, model, timeout_seconds (maximum 20).
# Groq: GROQ_API_KEY here; timeout_seconds in provider.settings (maximum 20).
# GROQ_API_KEY=
# Gemini: key above; explicit confirmation and a supported model are required.
# GEMINI_FREE_TIER_CONFIRMED=1
# GEMINI_TIMEOUT_SECONDS=20
# GEMINI_MODEL must be compatible with every configured consumer; use separate
# service environments if Receiving and Returns require different models.
